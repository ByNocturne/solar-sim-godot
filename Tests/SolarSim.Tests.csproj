<Project Sdk="Microsoft.NET.Sdk">

  <!-- Referencia apenas SolarSim.Engine. Nada de GodotSharp aqui: os testes
       precisam rodar com o Godot fechado, ou desinstalado. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SolarSim.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Engine/SolarSim.Engine.csproj" />
  </ItemGroup>

  <!-- A matematica de escala e de camera, o retrato de corpo e a formatacao moram em
       Bridge/, que faz parte do projeto do Godot e portanto nao pode ser referenciado
       daqui. Estes arquivos sao compilados tambem neste projeto para poderem ser
       testados. So funciona porque nenhum deles toca no Godot; se algum passar a tocar,
       este build quebra, o que e o aviso certo. -->
  <ItemGroup>
    <Compile Include="../Bridge/ScaleMapper.cs" Link="Bridge/ScaleMapper.cs" />
    <Compile Include="../Bridge/ScaleLayout.cs" Link="Bridge/ScaleLayout.cs" />
    <Compile Include="../Bridge/SystemProjector.cs" Link="Bridge/SystemProjector.cs" />
    <Compile Include="../Bridge/CameraRig.cs" Link="Bridge/CameraRig.cs" />
    <Compile Include="../Bridge/BodyReport.cs" Link="Bridge/BodyReport.cs" />
    <Compile Include="../Bridge/BodyFilter.cs" Link="Bridge/BodyFilter.cs" />
    <Compile Include="../Bridge/DisplayFormat.cs" Link="Bridge/DisplayFormat.cs" />
    <Compile Include="../Bridge/TeachingExplain.cs" Link="Bridge/TeachingExplain.cs" />
  </ItemGroup>

  <!-- Mesmo arranjo para o importador de catalogo: e um executavel, mas a leitura do CSV
       e a escrita do JSON sao funcoes puras, e o que elas produzem tem de ser conferido
       pelo mesmo carregador que o jogo usa. -->
  <ItemGroup>
    <Compile Include="../Tools/CatalogImporter/Csv.cs" Link="Tools/Csv.cs" />
    <Compile Include="../Tools/CatalogImporter/Palette.cs" Link="Tools/Palette.cs" />
    <Compile Include="../Tools/CatalogImporter/CatalogSource.cs" Link="Tools/CatalogSource.cs" />
    <Compile Include="../Tools/CatalogImporter/CatalogWriter.cs" Link="Tools/CatalogWriter.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>