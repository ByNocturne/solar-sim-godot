; Engine configuration file.
; Editado pelo Godot; alteracoes manuais podem ser sobrescritas.

config_version=5

[application]

config/name="Solar Sim"
config/description="Simulador do Sistema Solar com propagacao kepleriana analitica."
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[dotnet]

project/assembly_name="solar-sim-godot"

[rendering]

renderer/rendering_method="forward_plus"
