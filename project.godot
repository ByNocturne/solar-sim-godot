; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Solar Sim"
config/description="Simulador do Sistema Solar com propagacao kepleriana analitica."
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[display]

; Declarado em vez de herdado do padrao do Godot: ScaleLayout dimensiona o espaco de
; tela de cada nivel da hierarquia a partir desta altura.
window/size/viewport_width=1920
window/size/viewport_height=1080

[dotnet]

project/assembly_name="solar-sim-godot"
