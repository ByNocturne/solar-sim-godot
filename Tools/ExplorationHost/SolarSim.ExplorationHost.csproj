<Project Sdk="Microsoft.NET.Sdk">

  <!-- Host CLI do loop de exploração (Fase 4). Não entra no export Godot; só ProjectReference
       ao motor — prova o critério M20 de consumo sem SimBridge. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <RootNamespace>SolarSim.ExplorationHost</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Engine/SolarSim.Engine.csproj" />
  </ItemGroup>

</Project>
